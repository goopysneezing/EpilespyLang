# Play a retro beep sequence asynchronously
print("Playing retro arcade sound effects...")

# Scale: C4, E4, G4, C5 (arpeggio)
beep(261.63, 100) # C4
sleep(120)
beep(329.63, 100) # E4
sleep(120)
beep(392.00, 100) # G4
sleep(120)
beep(523.25, 250) # C5
sleep(300)

print("Playing space invader sound...")
beep(150, 50)
sleep(70)
beep(130, 50)
sleep(70)
beep(110, 50)
sleep(70)
beep(90, 150)
sleep(200)

print("Arcade tones finished!")
