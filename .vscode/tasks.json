{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build EpilespyLang",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/nologo",
                "/Fe${workspaceFolder}\\EpilespyLang.exe",
                "${workspaceFolder}\\main.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: cl.exe"
        }
    ],
    "version": "2.0.0"
}