{
    "tasks": [
        {
            "type": "shell",
            "label": "Build EpilespyLang",
            "command": "${workspaceFolder}\\.vscode\\build.bat",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/nologo",
                "/Fe${workspaceFolder}\\EpilespyLang.exe",
                "${workspaceFolder}\\main.cpp",
                "gdi32.lib",
                "user32.lib",
                "wininet.lib",
                "winmm.lib",
                "opengl32.lib",
                "shell32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: cl.exe"
        }
    ],
    "version": "2.0.0"
}